{
  "name": "video-transformer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-assets.mjs",
    "build": "tsc --noEmit && vite build",
